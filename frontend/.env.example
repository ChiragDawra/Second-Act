# Copy to frontend/.env (gitignored). Vite bundles every VITE_* value into the page,
# so these must be PUBLIC values only. Never put the service-role key or a database URL here.

# Supabase project URL and publishable (anon) key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Second Act API
VITE_API_URL=http://localhost:4000
