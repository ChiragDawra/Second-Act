{
  "name": "second-act-api",
  "version": "0.1.0",
  "private": true,
  "description": "Second Act application API: authentication, authorization, consent, Adjacency Engine and demo scenario.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "demo:seed": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "demo:reset": "tsx --env-file-if-exists=.env scripts/reset-demo.ts",
    "demo:smoke": "tsx --env-file-if-exists=.env scripts/smoke-demo.ts",
    "demo:check": "tsx --env-file-if-exists=.env scripts/check-setup.ts",
    "ncr:eval": "tsx --env-file-if-exists=.env scripts/ncr-eval.ts",
    "ncr:prepare": "tsx scripts/ncr-prepare.ts",
    "ncr:compare": "tsx scripts/ncr-compare.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
