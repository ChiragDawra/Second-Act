# Copy to apps/api/.env (gitignored) and fill in from your Supabase project:
# Dashboard → Project Settings → API / Database. Never commit the real file.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Publishable / anon key (safe for clients; used here only to verify sessions)
SUPABASE_ANON_KEY=
# Postgres connection string for the "postgres" user. Prefer the Session
# pooler string (IPv4): postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Secret service-role key. ONLY read by "npm run demo:seed" to create the four
# demo identities. The API server never uses it. Never put it in the app.
SUPABASE_SERVICE_ROLE_KEY=

# API server
PORT=4000
# Browser origins allowed to call the API (Expo web dev server). Native apps send no origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Demo accounts (optional). Emails become <name>@DEMO_EMAIL_DOMAIN.
DEMO_EMAIL_DOMAIN=demo.secondact.test
# Set these to keep memorable passwords across re-seeds; otherwise random ones
# are generated and written to demo-credentials.local.md (gitignored).
DEMO_PASSWORD_WORKER=
DEMO_PASSWORD_MENTOR=
DEMO_PASSWORD_RECRUITER=
DEMO_PASSWORD_ADMIN=

# Used by "npm run demo:smoke" (defaults to http://localhost:4000)
API_URL=
