# Publishable / anon key (safe for clients; RLS protects the data)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InptbGFubXBpZWFyZG14dXpobmdqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIyNDcxMDcsImV4cCI6MjEwNzgyMzEwN30.7dqS6R92sF6eAuAnFicHa-7l3h_LZP1x7kX--Fh9GVw
# Second Act API. Browser on this laptop: http://localhost:4000
# Phones with Expo Go on the same Wi-Fi: http://<laptop LAN IP>:4000 (printed when the API starts)
EXPO_PUBLIC_API_URL=http://localhost:4000
