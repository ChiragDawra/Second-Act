# Copy to apps/mobile/.env (gitignored). These values are PUBLIC: Expo bundles
# every EXPO_PUBLIC_* variable into the app. Never put passwords, the
# service-role key or the database URL here.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe for clients; RLS protects the data)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Second Act API. Browser on this laptop: http://localhost:4000
# Phones with Expo Go on the same Wi-Fi: http://<laptop LAN IP>:4000 (printed when the API starts)
EXPO_PUBLIC_API_URL=http://localhost:4000
